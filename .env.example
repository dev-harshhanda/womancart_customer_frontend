# Copy this file to `.env.local` (dev) or set in CI / hosting env (prod).
# Required: build/runtime fails if a key referenced in code is missing.

# Google Maps
# NEXT_PUBLIC_* is exposed to the browser. Restrict by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only key. Restrict by IP in Google Cloud. Never reach the browser.
GOOGLE_MAPS_API_KEY=

# Google API endpoints.
# Client-side (browser) — must be NEXT_PUBLIC_*
NEXT_PUBLIC_GOOGLE_GEOLOCATE_URL=
NEXT_PUBLIC_GOOGLE_GEOCODE_URL=
# Server-side (Next.js API routes / service files)
GOOGLE_GEOCODE_URL=
GOOGLE_DIRECTIONS_URL=
GOOGLE_PLACES_AUTOCOMPLETE_URL=
GOOGLE_PLACES_DETAILS_URL=

# Firebase Web SDK (all NEXT_PUBLIC_* values ship to the browser; that is by design for the Web SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Zendesk
NEXT_PUBLIC_ZENDESK_KEY=
